+bool LuaLoader::has_farfarvr_panel() {
+    std::scoped_lock lock{m_access_mutex};
+    if(m_needs_first_reset)return false;
+    return std::any_of(m_script_panels.begin(),m_script_panels.end(),[](const auto& p){return p.name=="Far Far VR"&&!p.state.expired();});
+}
+
+bool LuaLoader::draw_farfarvr_panel() {
+    std::scoped_lock _{m_access_mutex};
+    if (m_needs_first_reset) {
+        ImGui::TextWrapped("Initializing Far Far VR menu...");
+        return true;
+    }
+    for (auto& entry : m_script_panels) {
+        if (entry.name != "Far Far VR") continue;
+        auto state = entry.state.lock();
+        if (state == nullptr) continue;
+        std::scoped_lock __{state->context()->get_mutex()};
+        try {
+            state->context()->handle_protected_result(entry.fn());
+        } catch (const std::exception& e) {
+            state->context()->log_error(std::format("[FarFarVR] Menu error: {}", e.what()));
+            ImGui::TextWrapped("Far Far VR menu error. Close the game and check the VR log.");
+        } catch (...) {
+            state->context()->log_error("[FarFarVR] Unknown menu error");
+            ImGui::TextWrapped("Far Far VR menu error. Close the game and check the VR log.");
+        }
+        return true;
+    }
+    return false;
+}
