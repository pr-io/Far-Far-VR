+            else if (key==L"Gamepad_DPad_Left") mask=XINPUT_GAMEPAD_DPAD_LEFT;
+            else if (key==L"Gamepad_DPad_Right") mask=XINPUT_GAMEPAD_DPAD_RIGHT;
+        }
+
+    }
