+    }
+    static auto next_try=std::chrono::steady_clock::time_point{};
+    if(std::chrono::steady_clock::now()<next_try)return false;
+    next_try=std::chrono::steady_clock::now()+std::chrono::seconds(2);
+    auto format=desc.Format;
+    if(format==DXGI_FORMAT_B8G8R8A8_TYPELESS)format=DXGI_FORMAT_B8G8R8A8_UNORM;
+    if(format==DXGI_FORMAT_R8G8B8A8_TYPELESS)format=DXGI_FORMAT_R8G8B8A8_UNORM;
+    if(format==DXGI_FORMAT_R16G16B16A16_TYPELESS)format=DXGI_FORMAT_R16G16B16A16_FLOAT;
