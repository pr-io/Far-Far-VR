+struct FarFarResolutionValue final : IModValue {
+    bool draw(std::string_view) override{return false;}void draw_value(std::string_view) override{}
+    void config_load(const utility::Config&,bool) override{}void config_save(utility::Config&) override{}
+    std::string get_config_name() const override{return "OpenXR_ResolutionScale";}
+    std::string_view get_config_name_view() const override{return "OpenXR_ResolutionScale";}
+    std::string get() const override {auto* xr=VR::get()->get_openxr_runtime();return xr?xr->resolution_scale->get():"";}
+    void set(const std::string& text) override {
+        auto vr=VR::get();auto* xr=vr->get_openxr_runtime();if(!xr)return;
+        size_t used{};float value{};try{value=std::stof(text,&used);}catch(...){return;}
+        if(used!=text.size()||!std::isfinite(value)||value<.5f||value>1.5f)return;
+        if(value==xr->resolution_scale->value())return;
+        const auto old_scale=xr->last_applied_resolution_width?xr->last_applied_resolution_scale:xr->resolution_scale->value();
+        const auto old_width=xr->get_width(),old_height=xr->get_height();
+        xr->last_applied_resolution_scale=old_scale;
+        xr->last_applied_resolution_width=old_width;xr->last_applied_resolution_height=old_height;
+        xr->resolution_scale->set(text);
+        if(old_width&&old_height) {
+            const auto width=xr->get_width_for_scale(value),height=xr->get_height_for_scale(value);
+            const bool applied=vr->on_openxr_resolution_scale_changed(old_width,old_height,width,height);
+            xr->resolution_scale_live_apply_deferred=!applied;
+            if(applied){xr->last_applied_resolution_scale=value;xr->last_applied_resolution_width=width;xr->last_applied_resolution_height=height;}
+        }
+    }
+};
+struct FarFarGunTargetValue final : IModValue {
+    bool draw(std::string_view) override{return false;}void draw_value(std::string_view) override{}
+    void config_load(const utility::Config&,bool) override{}void config_save(utility::Config&) override{}
+    std::string get_config_name() const override{return "VR_FarFarGunAimTarget";}
+    std::string_view get_config_name_view() const override{return "VR_FarFarGunAimTarget";}
+    void set(const std::string& value) override {
+        glm::vec3 p{};char extra{};
+        const bool valid=std::sscanf(value.c_str(),"%f %f %f %c",&p.x,&p.y,&p.z,&extra)==3 &&
+            std::isfinite(p.x)&&std::isfinite(p.y)&&std::isfinite(p.z)&&glm::length(p)>.01f&&glm::length(p)<100000.f;
+        std::scoped_lock lock{farfar_aim_mutex};
+        farfar_aim_endpoint=valid?std::optional{p}:std::nullopt;farfar_aim_updated=farfarvr::reticle_now();
+    }
+    std::string get() const override{return "";}
+};
+struct FarFarGunAimValue final : IModValue {
+    bool draw(std::string_view) override{return false;}void draw_value(std::string_view) override{}
+    void config_load(const utility::Config&,bool) override{}void config_save(utility::Config&) override{}
+    void set(const std::string&) override{}
+    std::string get_config_name() const override{return "VR_FarFarGunAim";}
+    std::string_view get_config_name_view() const override{return "VR_FarFarGunAim";}
+    std::string get() const override {
+        const auto surface=farfarvr::read_reticle_surface();
+        if(surface.updated==0||farfarvr::reticle_now()-surface.updated>500)return "waiting";
+        const auto vr=VR::get();
+        glm::vec3 point;
+        {std::scoped_lock lock{farfar_aim_mutex};
+            if(!farfar_aim_endpoint||farfarvr::reticle_now()-farfar_aim_updated>100)return "waiting";
+            point=*farfar_aim_endpoint*(.01f/std::max(.1f,vr->get_world_scale()));}
+        const auto uv=farfarvr::firing_point_project(surface,point,glm::vec3{vr->get_position(0,false)},glm::quat{vr->get_rotation(0,false)});
+        if(!uv.valid)return "outside";
+        return std::to_string(uv.x)+" "+std::to_string(uv.y);
+    }
+};
