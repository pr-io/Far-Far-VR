+uint16_t farfar_emote_button() {
+    static uint16_t mask{};
+    if (mask) return mask;
+    static auto next_scan=std::chrono::steady_clock::time_point{};
+    const auto now=std::chrono::steady_clock::now();
+    if (now<next_scan) return 0;
+    next_scan=now+std::chrono::seconds(2);
+    auto* ctx=sdk::find_uobject(L"InputMappingContext /Game/Player/Inputs/IMC_Inputs.IMC_Inputs");
+    if (!ctx) return 0;
+    auto* def=ctx->get_class()->find_property(L"DefaultKeyMappings");
+    if (!def || def->get_class()->get_name().to_string()!=L"StructProperty") return 0;
+    auto* def_struct=static_cast<sdk::FStructProperty*>(def)->get_struct();
+    if (!def_struct) return 0;
+    auto* arr_prop=def_struct->find_property(L"Mappings");
+    if (!arr_prop || arr_prop->get_class()->get_name().to_string()!=L"ArrayProperty") return 0;
+    auto* inner=static_cast<sdk::FArrayProperty*>(arr_prop)->get_inner();
+    if (!inner || inner->get_class()->get_name().to_string()!=L"StructProperty") return 0;
+    auto* desc=static_cast<sdk::FStructProperty*>(inner)->get_struct();
+    if (!desc) return 0;
+    auto* action_prop=desc->find_property(L"Action");
+    auto* key_prop=desc->find_property(L"Key");
+    if (!action_prop || !key_prop) return 0;
+    auto* key_desc=static_cast<sdk::FStructProperty*>(key_prop)->get_struct();
+    auto* name_prop=key_desc ? key_desc->find_property(L"KeyName") : nullptr;
+    if (!name_prop) return 0;
+    struct Array { uint8_t* data; int32_t count,capacity; };
+    const auto& array=*arr_prop->get_data<Array>(def->get_data<void>(ctx));
+    const auto stride=desc->get_struct_size();
+    if (!array.data || array.count<1 || array.count>256 || array.capacity<array.count || stride<32 || stride>1024) return 0;
+    static bool dumped{};
+    for (int32_t i=0;i<array.count;++i) {
+        auto* item=array.data+i*stride;
+        auto* action=*action_prop->get_data<sdk::UObjectBase*>(item);
+        if (!action) continue;
+        const auto name=action->get_full_name();
+        const auto key=name_prop->get_data<sdk::FName>(key_prop->get_data<void>(item))->to_string();
+        SPDLOG_INFO_ONCE("[FarFarVR][Input] Native mapping array validated stride={} count={}",stride,array.count);
+        // Recorded once for matching the game's own action, not a controller convention.
+        if (!dumped) SPDLOG_INFO("[FarFarVR][Mapping] {} -> {}",utility::narrow(name),utility::narrow(key));
