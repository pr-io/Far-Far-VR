+    if (auto* active=depth<=3?klass->find_function(L"GetActiveWidget"):nullptr) {
+        struct { sdk::UObject* value{}; } p{};
+        if (active->get_properties_size()<=sizeof(p)) { widget->process_event(active,&p); return farfar_pointer_mix(h,farfar_pointer_tree(p.value,depth+1,budget)); }
+    }
+    if (auto* children=klass->find_function(L"GetAllChildren")) {
+        struct { sdk::TArray<sdk::UObject*> values{}; } p{};
+        if (children->get_properties_size()<=sizeof(p)) {
+            widget->process_event(children,&p);
+            if (p.values.count>=0 && p.values.count<=256)
+                for (int i=0;i<p.values.count;++i) h=farfar_pointer_mix(h,farfar_pointer_tree(p.values.data[i],depth+1,budget));
+        }
+    }
+    return h;
+}
+uint64_t farfar_pointer_page(sdk::UObject* world,sdk::UObject* pc,uint64_t seed) {
+    auto* lib=sdk::find_uobject<sdk::UClass>(L"Class /Script/UMG.WidgetBlueprintLibrary");
+    auto* type=sdk::find_uobject<sdk::UClass>(L"Class /Script/UMG.UserWidget");
+    auto* obj=lib?lib->get_class_default_object():nullptr;
+    auto* fn=lib?lib->find_function(L"GetAllWidgetsOfClass"):nullptr;
+    if (!obj || !type || !fn) return seed;
+    struct Params { sdk::UObject* world{}; sdk::TArray<sdk::UObject*> widgets{}; sdk::UClass* type{}; bool top{true}; } p{};
+    auto offset=[&](const wchar_t* n,int expected){auto* v=fn->find_property(n); return v && v->get_offset()==expected;};
+    if (!offset(L"WorldContextObject",0)||!offset(L"FoundWidgets",8)||!offset(L"WidgetClass",24)||!offset(L"TopLevelOnly",32)||fn->get_properties_size()>sizeof(p)) {
+        SPDLOG_ERROR_ONCE("[FarFarVR][Pointer] Widget inventory layout rejected; using cursor-screen lifetime only"); return seed;
+    }
+    p.world=world;p.type=type;obj->process_event(fn,&p);
+    if(p.widgets.count<0||p.widgets.count>2048)return seed;
+    std::vector<uint64_t> roots;
+    for(int i=0;i<p.widgets.count;++i) {
+        auto* w=p.widgets.data[i]; if(!farfar_pointer_widget(w))continue;
+        auto* owner_fn=w->get_class()->find_function(L"GetOwningPlayer");
+        struct {sdk::UObject* value{};} owner{};
+        if(!owner_fn||owner_fn->get_properties_size()>sizeof(owner))continue;
+        w->process_event(owner_fn,&owner);if(owner.value&&owner.value!=pc)continue;
+        const auto name=w->get_class()->get_fname().to_string();
+        // Persistent gameplay HUD subtrees (hit effects, POIs) must not reset
+        // an analog navigation choice while a separate selection page is open.
+        if(name.starts_with(L"UI_Player")||name.find(L"Damage")!=std::wstring::npos||name.find(L"Ping")!=std::wstring::npos)continue;
+        uint64_t key=reinterpret_cast<uintptr_t>(w);
+        if(auto tree=read_object_property(w,L"WidgetTree");tree&&*tree) {
+            if(auto root=read_object_property(*tree,L"RootWidget");root&&*root){unsigned budget=256;key=farfar_pointer_mix(key,farfar_pointer_tree(*root,0,budget));}
+        }
+        roots.push_back(key);
+    }
+    std::sort(roots.begin(),roots.end());for(auto n:roots)seed=farfar_pointer_mix(seed,n);
+    return seed?seed:1;
+}
