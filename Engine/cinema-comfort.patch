+Microsoft::WRL::ComPtr<ID3D12Resource> VR::get_farfar_effects_texture() {
+    Microsoft::WRL::ComPtr<ID3D12Resource> result;
+    if(!can_submit_farfar_effects())return result;
+    try {
+        sdk::object_liveness::Identity identity{};
+        {std::scoped_lock lock{m_farfar_effects_mtx};if(m_farfar_effects_texture_owner!=m_farfar_effects_source.load())return result;identity=m_farfar_effects_texture;}
+        if(!sdk::is_current_object(identity))return result;
+        auto* tex=reinterpret_cast<sdk::UTexture*>(identity.object);
+        auto* rhi=tex->get_texture_rhi();if(!rhi)return result;
+        auto* native=static_cast<ID3D12Resource*>(rhi->get_native_resource());if(!native)return result;
+        const auto desc=native->GetDesc();
+        if(desc.Dimension!=D3D12_RESOURCE_DIMENSION_TEXTURE2D||desc.Width!=1024||desc.Height!=1024||desc.SampleDesc.Count!=1||desc.DepthOrArraySize!=1)return result;
+        Microsoft::WRL::ComPtr<ID3D12Device> device;
+        if(FAILED(native->GetDevice(IID_PPV_ARGS(&device)))||device.Get()!=g_framework->get_d3d12_hook()->get_device())return result;
+        result=native;
+    }catch(...){SPDLOG_ERROR_EVERY_N_SEC(5,"[FarFarVR][Effects] Render texture unavailable; original effects retained");}
+    return result;
+}
