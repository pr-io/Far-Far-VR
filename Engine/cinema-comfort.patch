+    if (found.empty()) {
+        m_farfar_controls_failed = true;
+        return 0;
+    }
+
+    try {
+        DirectX::ResourceUploadBatch upload{ device };
+        upload.Begin();
+        HRESULT hr = DirectX::CreateWICTextureFromFile(
+            device,
+            upload,
+            found.c_str(),
+            m_farfar_controls_tex.GetAddressOf());
+        if (FAILED(hr) || m_farfar_controls_tex == nullptr) {
+            m_farfar_controls_failed = true;
+            return 0;
+        }
+        auto result = upload.End(queue);
+        result.wait();
+
+        D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc{};
+        srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        srv_desc.Format = m_farfar_controls_tex->GetDesc().Format;
+        srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        srv_desc.Texture2D.MipLevels = m_farfar_controls_tex->GetDesc().MipLevels;
+
+        device->CreateShaderResourceView(
+            m_farfar_controls_tex.Get(),
+            &srv_desc,
+            g_framework->m_d3d12.get_cpu_srv(device, Framework::D3D12::SRV::FARFARVR_CONTROLS));
+
+        m_farfar_controls_srv_gpu = g_framework->m_d3d12.get_gpu_srv(device, Framework::D3D12::SRV::FARFARVR_CONTROLS).ptr;
+        m_farfar_controls_loaded = true;
+        spdlog::info("[FarFarVR] Controls texture loaded into D3D12 from {}", found.string());
+        return m_farfar_controls_srv_gpu;
+    } catch (const std::exception& e) {
+        spdlog::error("[FarFarVR] Exception loading controls texture into D3D12: {}", e.what());
+        m_farfar_controls_failed = true;
+        return 0;
+    }
+}
+
+void D3D12Component::reset_farfar_controls_texture() {
+    m_farfar_controls_tex.Reset();
+    m_farfar_controls_srv_gpu = 0;
+    m_farfar_controls_loaded = false;
+    m_farfar_controls_failed = false;
+}
 } // namespace vrmod
