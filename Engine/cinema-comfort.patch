+void VR::tick_farfar_effects(sdk::UGameEngine* engine) {
+    m_farfar_effects_allowed=false;
+    if(!is_farfarwest_executable_cached())return;
+    try {
+        auto* world=engine?engine->get_world():nullptr;auto* ugs=sdk::UGameplayStatics::get();
+        auto* pc=world&&ugs?ugs->get_player_controller(world,0):nullptr;
+        auto* pawn=pc?pc->get_acknowledged_pawn():nullptr;
+        auto* comp=reinterpret_cast<sdk::UObject*>(m_farfar_effects_source.load());
+        auto identity=sdk::observe_uobject(comp);
+        auto* klass=sdk::find_uobject<sdk::UClass>(L"Class /Script/UMG.WidgetComponent");
+        if(!pc||!pawn||!identity||!klass||!comp->is_a(klass))return;
+        if(pc->get_bool_property(L"bShowMouseCursor")||is_using_2d_screen()||g_framework->is_drawing_ui()||get_farfar_pointer_view().mode.active)return;
+        const auto name=reinterpret_cast<sdk::UObject*>(pawn)->get_class()->get_fname().to_string();
+        if(!name.starts_with(L"BP_Player")&&!name.starts_with(L"BP_Mount_C"))return;
+        struct ObjectReturn{sdk::UObject* value{};} owner{},texture{};
+        auto* of=comp->get_class()->find_function(L"GetOwner");auto* tf=comp->get_class()->find_function(L"GetRenderTarget");
+        if(!of||!tf||of->get_properties_size()>sizeof(owner)||tf->get_properties_size()>sizeof(texture))return;
+        comp->process_event(of,&owner);if(owner.value!=reinterpret_cast<sdk::UObject*>(pawn))return;
+        comp->process_event(tf,&texture);
+        const auto tex=sdk::observe_uobject(texture.value);if(!tex)return;
+        auto* target=sdk::find_uobject<sdk::UClass>(L"Class /Script/Engine.TextureRenderTarget2D");
+        if(!target||!texture.value->is_a(target))return;
+        {std::scoped_lock lock{m_farfar_effects_mtx};m_farfar_effects_texture=tex->identity;m_farfar_effects_texture_owner=reinterpret_cast<uintptr_t>(comp);}
+        m_farfar_effects_allowed=get_runtime()->is_openxr()&&get_runtime()->ready()&&is_hmd_active();
+    }catch(...){SPDLOG_ERROR_EVERY_N_SEC(5,"[FarFarVR][Effects] Effects component validation failed; original effects retained");}
