+namespace {
+safetyhook::InlineHook* farfar_exit_hook{};
+struct FarFarExitWatchdog {
+    HANDLE completed{};
+    DWORD exit_status{};
+};
+DWORD WINAPI force_exit_if_stalled(void* context) {
+    const auto* state = static_cast<const FarFarExitWatchdog*>(context);
+    if (WaitForSingleObject(state->completed, 5000) != WAIT_OBJECT_0) {
+        TerminateProcess(GetCurrentProcess(), state->exit_status);
+    }
+    return 0;
+}
+void NTAPI finish_farfar_exit(LONG status) {
+    // Release Meta/OpenXR while its IPC worker threads are still alive. Waiting
+    // until DLL_PROCESS_DETACH leaves Meta's hand-interaction DLL waiting on
+    // threads Windows has already terminated under the loader lock.
+    const auto completed = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    if (!completed) {
+        TerminateProcess(GetCurrentProcess(), static_cast<DWORD>(status));
+        return;
+    }
+    FarFarExitWatchdog state{completed, static_cast<DWORD>(status)};
+    const auto watchdog = CreateThread(nullptr, 0, force_exit_if_stalled, &state, 0, nullptr);
+    if (!watchdog) {
+        CloseHandle(completed);
+        TerminateProcess(GetCurrentProcess(), static_cast<DWORD>(status));
+        return;
+    }
+    if(const auto vr=VR::get()) {
+        vr->stop_native_openxr_async_wait_worker();
+        if(const auto xr=vr->get_openxr_runtime())xr->destroy();
+    }
+    SetEvent(completed);
+    WaitForSingleObject(watchdog, INFINITE);
+    CloseHandle(watchdog);
+    CloseHandle(completed);
+    farfar_exit_hook->call<void>(status);
+}
+}
