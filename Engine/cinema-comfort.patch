+void VR::update_farfar_pointer_inputs() {
+    if(!is_farfarwest_executable_cached())return;
+    const bool enabled=get_runtime()->is_openxr()&&get_runtime()->ready()&&is_hmd_active()&&m_controllers_allowed->value()&&!m_controllers.empty()
+        &&!g_framework->is_drawing_ui()&&GetForegroundWindow()==g_framework->get_window();
+    const bool l=is_action_active(m_action_trigger,get_left_joystick());
+    const bool r=is_action_active(m_action_trigger,get_right_joystick());
+    const auto ls=get_left_stick_axis(),rs=get_right_stick_axis();
+    const float stick=std::max({std::abs(ls.x),std::abs(ls.y),std::abs(rs.x),std::abs(rs.y)});
+    const auto now=farfar_pointer_now();
+    std::scoped_lock lock{m_farfar_pointer_mtx};
+    const auto fresh=[&](unsigned hand){const auto& v=m_farfar_pointer_hits[hand];return v.valid&&now-v.time>=0&&now-v.time<150;};
+    auto mode=m_farfar_pointer.update({m_farfar_pointer_page,enabled,l,r,fresh(0),fresh(1),stick,gamepad_trigger_value(get_left_joystick(),0)!=0,gamepad_trigger_value(get_right_joystick(),0)!=0,
+        is_gamepad_face_action_active(m_action_a_button_right,m_action_a_button_left)});
+    m_farfar_pointer_view={mode,m_farfar_pointer_hits[mode.hand]};
+    if(!fresh(mode.hand))m_farfar_pointer_view.hit.valid=false;
+}
+void VR::tick_farfar_pointer(sdk::UGameEngine* engine) {
+    if(!is_farfarwest_executable_cached())return;
+    sdk::APlayerController* pc{};uint64_t page{};
+    try {
+        auto* world=engine?engine->get_world():nullptr;auto* ugs=sdk::UGameplayStatics::get();
+        pc=world&&ugs?ugs->get_player_controller(world,0):nullptr;
+        auto* object=reinterpret_cast<sdk::UObject*>(pc);
+        auto* pawn=pc?reinterpret_cast<sdk::UObject*>(pc->get_acknowledged_pawn()):nullptr;
+        bool cursor=false,wheel=false,title=false;
+        if(object) {auto* prop=object->get_class()->find_property(L"bShowMouseCursor");if(prop&&prop->get_class()->get_name().to_string()==L"BoolProperty")cursor=object->get_bool_property(L"bShowMouseCursor");}
+        if(pawn) {
+            title=pawn->get_class()->get_fname().to_string().find(L"BP_TitleScreen_C")!=std::wstring::npos;
+            if(auto value=read_object_property(pawn,L"ui_Emote");value&&*value)wheel=farfar_pointer_widget(*value);
+        }
+        m_farfar_selection_screen=!pc||!pawn||cursor||wheel||title;
+        const bool eligible=pc&&(cursor||wheel||title)&&!is_using_2d_screen()&&get_runtime()->is_openxr()&&get_runtime()->ready()&&is_hmd_active();
+        if(eligible) {
+            const uint64_t seed=farfar_pointer_mix(reinterpret_cast<uintptr_t>(pc),wheel?2:title?3:1);
+            static uint64_t previous_seed{},cached_page{};static int64_t next_scan{};
+            const auto now=farfar_pointer_now();
+            if(seed!=previous_seed||now>=next_scan){cached_page=farfar_pointer_page(reinterpret_cast<sdk::UObject*>(world),object,seed);previous_seed=seed;next_scan=now+150;}
+            page=cached_page;
+        }
+    } catch(...) {m_farfar_selection_screen=true;SPDLOG_ERROR_EVERY_N_SEC(5,"[FarFarVR][Pointer] Selection-screen inspection failed; pointer disabled");}
+    {std::scoped_lock lock{m_farfar_pointer_mtx};m_farfar_pointer_page=page;}
+    update_farfar_pointer_inputs();
+    const auto view=get_farfar_pointer_view();
+    const auto window=g_framework->get_window();
+    const bool point=view.mode.active&&view.mode.laser&&view.hit.valid&&pc&&GetForegroundWindow()==window;
+    POINT pos{};bool positioned=false;
+    if(point) {
+        auto* fn=pc->get_class()->find_function(L"SetMouseLocation");
+        RECT client{};GetClientRect(window,&client);
+        if(fn&&fn->get_properties_size()<=8&&client.right>0&&client.bottom>0) {
+            struct {int x{},y{};} p{int(view.hit.x*client.right),int(view.hit.y*client.bottom)};
+            p.x=std::clamp(p.x,0,int(client.right)-1);p.y=std::clamp(p.y,0,int(client.bottom)-1);
+            auto* xp=fn->find_property(L"X"),*yp=fn->find_property(L"Y");
+            if(xp&&yp&&xp->get_offset()==0&&yp->get_offset()==4) {
+                pc->process_event(fn,&p);pos={p.x,p.y};
+                positioned=PostMessageW(window,WM_MOUSEMOVE,0,MAKELPARAM(pos.x,pos.y))!=0;
+            }
+        }
+        if(!positioned)SPDLOG_ERROR_EVERY_N_SEC(5,"[FarFarVR][Pointer] Mouse positioning unavailable; click withheld");
+    }
+    const bool down=point&&positioned&&view.mode.down;
+    if(m_farfar_mouse_down&&(!down||m_farfar_click_hand!=view.mode.hand)) {
+        PostMessageW(window,WM_LBUTTONUP,0,MAKELPARAM(pos.x,pos.y));m_farfar_mouse_down=false;
+    }
+    if(!m_farfar_mouse_down&&down) {
+        m_farfar_mouse_down=PostMessageW(window,WM_LBUTTONDOWN,MK_LBUTTON,MAKELPARAM(pos.x,pos.y))!=0;
+        m_farfar_click_hand=view.mode.hand;
+    }
+}
