+uint64_t D3D11Component::get_farfar_controls_texture_id() {
+    if (m_farfar_controls_loaded && m_farfar_controls_srv != nullptr) {
+        return reinterpret_cast<uint64_t>(m_farfar_controls_srv.Get());
+    }
+    if (m_farfar_controls_failed) {
+        return 0;
+    }
+    auto& hook = g_framework->get_d3d11_hook();
+    if (!hook) return 0;
+    auto device = hook->get_device();
+    if (!device) return 0;
+
+    const auto dir = Framework::get_persistent_dir();
+    const std::vector<std::filesystem::path> candidates = {
+        dir / "textures" / "farfarvr_controls.png",
+        dir / "textures" / "farfarvr_controls.jpg",
+        dir / "farfarvr_controls.png",
+        dir / "farfarvr_controls.jpg"
+    };
+    std::filesystem::path found{};
+    for (const auto& p : candidates) {
+        if (std::filesystem::exists(p)) {
+            found = p;
+            break;
+        }
+    }
+    if (found.empty()) {
+        m_farfar_controls_failed = true;
+        return 0;
+    }
+
+    try {
+        Microsoft::WRL::ComPtr<ID3D11Resource> res{};
+        HRESULT hr = DirectX::CreateWICTextureFromFile(
+            device,
+            found.c_str(),
+            res.GetAddressOf(),
+            m_farfar_controls_srv.GetAddressOf());
+        if (FAILED(hr) || m_farfar_controls_srv == nullptr) {
+            m_farfar_controls_failed = true;
+            return 0;
+        }
+        m_farfar_controls_loaded = true;
+        spdlog::info("[FarFarVR] Controls texture loaded into D3D11 from {}", found.string());
+        return reinterpret_cast<uint64_t>(m_farfar_controls_srv.Get());
+    } catch (const std::exception& e) {
+        spdlog::error("[FarFarVR] Exception loading controls texture into D3D11: {}", e.what());
+        m_farfar_controls_failed = true;
+        return 0;
+    }
+}
+
+void D3D11Component::reset_farfar_controls_texture() {
+    m_farfar_controls_srv.Reset();
+    m_farfar_controls_loaded = false;
+    m_farfar_controls_failed = false;
+}
 } // namespace vrmod
