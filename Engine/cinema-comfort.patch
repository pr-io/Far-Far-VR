+uint64_t farfar_pointer_mix(uint64_t h,uint64_t n) { return (h^n)*1099511628211ull; }
+uint64_t farfar_pointer_tree(sdk::UObject* widget,unsigned depth,unsigned& budget) {
+    if (!widget || depth>10 || budget==0) return 0;
